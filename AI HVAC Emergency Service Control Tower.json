              "value": "=[{\"tech_id\":\"TECH-001\",\"name\":\"Ali Raza\",\"city\":\"Lahore\",\"status\":\"available\",\"available_from\":\"15:00\",\"skills\":[\"AC\",\"compressor\",\"electrical\"],\"distance_km\":6,\"truck_parts\":[\"capacitor\",\"contactor\",\"refrigerant\"]},{\"tech_id\":\"TECH-002\",\"name\":\"Hamza Khan\",\"city\":\"Lahore\",\"status\":\"busy\",\"available_from\":\"16:30\",\"skills\":[\"AC\"],\"distance_km\":4,\"truck_parts\":[\"contactor\"]},{\"tech_id\":\"TECH-003\",\"name\":\"Usman Tariq\",\"city\":\"Lahore\",\"status\":\"available\",\"available_from\":\"14:45\",\"skills\":[\"AC\",\"electrical\"],\"distance_km\":18,\"truck_parts\":[\"capacitor\"]}]",
              "type": "string"
