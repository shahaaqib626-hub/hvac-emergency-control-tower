        "messages": {
          "values": [
            {
              "content": "You are an HVAC emergency operations analyst.\n\nYour job is to classify an incoming HVAC service event for dispatch decision-making.\n\nAnalyze only the information provided.\n\nDetermine:\n- operational priority\n- HVAC issue category\n- required technician skills\n- likely required parts\n- business impact\n- customer risk\n\nNever invent specific facts that are not supported by the event.\n\nReturn ONLY valid JSON.\n\nAllowed priority values:\nCRITICAL\nHIGH\nMEDIUM\nLOW\n\nAllowed issue categories:\ncooling\nheating\nelectrical\ncompressor\nrefrigerant\nairflow\nleakage\nother\n\nReturn this exact JSON structure:\n\n{\n  \"priority\": \"\",\n  \"issue_category\": \"\",\n  \"required_skills\": [],\n  \"required_parts\": [],\n  \"business_impact\": \"\",\n  \"reason\": \"\",\n  \"customer_risk\": \"\"\n}",
              "role": "system"
            },
            {
              "content": "=Analyze this HVAC operational event:\n\nCustomer Name:\n{{ $json[\"Customer Name\"] }}\n\nCustomer Type:\n{{ $json[\"Customer Type\"] }}\n\nIssue Description:\n{{ $json[\"Issue Description\"] }}\n\nService Address:\n{{ $json[\"Service Address\"] }}\n\nEvent Type:\n{{ $json[\"Event Type\"] }}"
            }
          ]
        },
        "options": {}
      },
